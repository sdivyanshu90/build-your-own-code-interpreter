# ─────────────────────────────────────────────────────────────────────────────────────────────
# Code Interpreter Sandbox — environment configuration
# Copy to `.env` (`cp .env.example .env`) and adjust. docker compose auto-loads `.env`.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
LOG_LEVEL=info                       # trace | debug | info | warn | error | fatal

# ── API server ───────────────────────────────────────────────────────────────────────────────
API_PORT=8080                        # host port the API is published on
# JWT signing secret — MUST be >=32 chars and not a well-known value. Generate a strong one:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-32chars!!
ALLOW_ANONYMOUS=true                 # allow unauthenticated execution (set false in prod)
CORS_ORIGINS=http://localhost:3000   # comma-separated allowlist; NEVER "*" in production
# Comma-separated machine API keys, each "<key>:<tier>" where tier is authenticated|premium.
#   API_KEYS=svc_abc123:premium,ci_xyz789:authenticated
API_KEYS=

# ── Limits / quotas ──────────────────────────────────────────────────────────────────────────
MAX_CODE_SIZE_BYTES=262144           # 256 KiB max source size
MAX_STDIN_BYTES=262144               # 256 KiB max stdin
DEFAULT_TIMEOUT_SECONDS=10           # default wall-clock timeout
MAX_TIMEOUT_SECONDS=30               # ceiling a request may ask for
SYNC_EXECUTION_TIMEOUT_SECONDS=30    # ceiling for the synchronous /v1/execute long-poll
RATE_LIMIT_REQUESTS_PER_MINUTE=60    # authenticated tier
RATE_LIMIT_ANON_PER_MINUTE=10        # anonymous tier
RATE_LIMIT_PREMIUM_PER_MINUTE=600    # premium tier
MAX_CONCURRENT_JOBS=5                # per-user concurrent jobs (authenticated)
MAX_CONCURRENT_JOBS_PREMIUM=25       # per-user concurrent jobs (premium)

# ── Worker ───────────────────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4                 # max concurrent sandboxes per worker process
# Host directory shared with the worker for per-job code dirs. The Docker daemon must be able
# to bind-mount paths under here into sandboxes, so it is a real host path.
SANDBOX_HOST_WORKDIR=/tmp/code-sandbox-work
SANDBOX_IMAGE_TAG=latest             # tag of the runtime images (sandbox-runtime-<lang>:<tag>)
QUEUE_BLOCK_MS=5000                  # XREADGROUP block duration
QUEUE_READ_COUNT=10                  # max messages fetched per poll
QUEUE_CLAIM_MIN_IDLE_MS=60000        # reclaim jobs idle longer than this (dead-worker recovery)
QUEUE_MAX_RETRIES=3                  # deliveries before a job is dead-lettered
SIGTERM_GRACE_SECONDS=2              # grace between SIGTERM and SIGKILL on timeout/cancel
METRICS_PORT=9100                    # worker Prometheus exposition port

# ── Redis ────────────────────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── MinIO (S3-compatible artifact store) ─────────────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=sandbox-artifacts
MINIO_USE_SSL=false

# ── Monitoring ───────────────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Tracing (optional) ───────────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=         # e.g. http://otel-collector:4318 ; empty disables export
OTEL_SERVICE_NAME=sandbox-api

# ── Production image references (used by docker-compose.prod.yml) ─────────────────────────────
IMAGE_REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest
