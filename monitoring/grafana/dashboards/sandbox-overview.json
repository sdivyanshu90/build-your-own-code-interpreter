    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "name": "DS_PROM",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "current": {
          "text": "Loki",
          "value": "loki"
        },
        "name": "DS_LOKI",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0
      }
