{
  "name": "code-sandbox-api",
  "version": "1.0.0",
  "description": "HTTP/WebSocket API gateway for the Code Interpreter Sandbox",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "helmet": "7.2.0",
    "ioredis": "5.4.2",
    "minio": "8.0.3",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "prom-client": "15.1.3",
    "ulid": "2.3.0",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/ws": "8.5.13",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "8.57.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
